# Shared zsh block, managed by ghostty/install.
# Everything here must work on both Linux and macOS.

# Shared env vars and aliases
if [[ -r ~/.bashrc ]]; then
  source ~/.bashrc
fi

# Prompt
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# OS icon defaults to the platform's own; each zshrc-os may override it.
