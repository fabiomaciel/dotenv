# macOS-specific zsh block, managed by ghostty/macos/install.
# Only sourced on macOS; uses Homebrew paths resolved by the installer.
#
# Order matters: the Powerlevel10k instant prompt must be the very first thing
# loaded, and powerlevel10k itself must be sourced exactly once.

# Enable Powerlevel10k instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Homebrew (Apple Silicon and Intel)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# oh-my-zsh, if installed
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# Powerlevel10k, sourced exactly once. Probe every layout Homebrew and a manual
# clone can produce: `powerlevel10k` and `zsh-theme-powerlevel10k` formulas put
# the theme in different places, and `brew install` leaves it keg-only.
if (( ! ${+functions[p10k]} )); then
  for theme in \
    "$ZSH/themes/powerlevel10k/powerlevel10k.zsh-theme" \
    "${ZSH_CUSTOM:-$ZSH/custom}/themes/powerlevel10k/powerlevel10k.zsh-theme" \
    /opt/homebrew/share/powerlevel10k/powerlevel10k.zsh-theme \
    /usr/local/share/powerlevel10k/powerlevel10k.zsh-theme \
    /opt/homebrew/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme \
    /usr/local/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme \
    /opt/homebrew/opt/powerlevel10k/share/powerlevel10k/powerlevel10k.zsh-theme \
    /usr/local/opt/powerlevel10k/share/powerlevel10k/powerlevel10k.zsh-theme; do
    if [[ -r "$theme" ]]; then
      source "$theme"
      break
    fi
  done
fi

if (( ${+functions[p10k]} )); then
  # Prompt config, sourced once.
  [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
else
  print -u2 "p10k: theme not found; prompt will fall back to zsh's default"
fi

# Prompt OS icon: ghost (Tux is Linux-only).
typeset -g POWERLEVEL9K_OS_ICON_CONTENT_EXPANSION=$'\U000F02A0'

# Plugins (paths differ between Apple Silicon and Intel, so probe both)
for dir in /opt/homebrew/share /usr/local/share /usr/share; do
  [[ -r "$dir/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && source "$dir/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [[ -r "$dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && source "$dir/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  [[ -r "$dir/zsh-history-substring-search/zsh-history-substring-search.zsh" ]] && source "$dir/zsh-history-substring-search/zsh-history-substring-search.zsh"
done

# fzf keybindings and completion
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --zsh)"
fi
