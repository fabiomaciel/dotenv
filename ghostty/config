# Ghostty configuration (shared)
# Docs: https://ghostty.org/docs/config
#
# Included by ghostty/linux/config and ghostty/macos/config via `config-file`.
# OS-specific options live in those files.

# Font
font-family = MesloLGS Nerd Font Mono
font-size = 12

# Window
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
confirm-close-surface = false
window-save-state = always
