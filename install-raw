#!/usr/bin/env bash
# Downloads this repo as a tarball from GitHub and unpacks it into ./dotenv.
# Meant for machines that do not have git yet: only curl and tar are needed.
#
# Usage: ./install-raw [--dry-run]

set -euo pipefail

REPO="fabiomaciel/dotenv"
BRANCH="main"
DEST="dotenv"
TARBALL="https://codeload.github.com/$REPO/tar.gz/refs/heads/$BRANCH"

DRY_RUN=0
case "${1:-}" in
  --dry-run) DRY_RUN=1 ;;
  "") ;;
  *)
    echo "Usage: $0 [--dry-run]" >&2
    exit 2
    ;;
esac

log()   { printf '  %s\n' "$*"; }
head_() { printf '\n==> %s\n' "$*"; }
ok()    { printf '  [ok] %s\n' "$*"; }
warn()  { printf '  [warn] %s\n' "$*" >&2; }

(( DRY_RUN )) && echo "DRY RUN: nothing will be changed."

for cmd in curl tar; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    warn "$cmd é necessário"
    exit 1
  fi
done

if [[ -e "$DEST" ]] && [[ -n "$(ls -A "$DEST" 2>/dev/null)" ]]; then
  warn "$DEST já existe e não está vazio; remova ou rode em outro diretório"
  exit 1
fi

head_ "Baixando $REPO@$BRANCH"
log "$TARBALL"

if (( DRY_RUN )); then
  log "would download and unpack into $DEST/"
  echo
  echo "  Nada foi baixado. Rode sem --dry-run para baixar."
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

if ! curl -fsSL "$TARBALL" -o "$tmp/repo.tar.gz"; then
  warn "falhou o download de $TARBALL"
  exit 1
fi
ok "tarball baixado ($(du -h "$tmp/repo.tar.gz" | cut -f1))"

head_ "Extraindo para $DEST/"
mkdir -p "$tmp/src"
if ! tar -xzf "$tmp/repo.tar.gz" -C "$tmp/src"; then
  warn "falhou ao extrair o tarball"
  exit 1
fi

# GitHub wraps everything in a single top-level directory (repo-branch/).
root="$(find "$tmp/src" -mindepth 1 -maxdepth 1 -type d | head -1)"
if [[ -z "$root" ]]; then
  warn "tarball inesperado: sem diretório raiz"
  exit 1
fi

mkdir -p "$DEST"
cp -a "$root"/. "$DEST"/

ok "$(find "$DEST" -type f | wc -l | tr -d ' ') arquivos"

head_ "Done"
echo "  Repositório montado em $(pwd)/$DEST"
echo "  Para instalar: cd $DEST && ./install"
